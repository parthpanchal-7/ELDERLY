# =============================================================================
# SaathiCare Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/saathicare?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# Authentication & Sessions
# -----------------------------------------------------------------------------
# JWT secret for access tokens (min 32 chars, use: openssl rand -hex 32)
JWT_SECRET=your-jwt-secret-at-least-32-characters-long

# JWT secret for refresh tokens (different from access token secret)
JWT_REFRESH_SECRET=your-jwt-refresh-secret-at-least-32-characters-long

# Session secret for express-session / cookie signing
SESSION_SECRET=your-session-secret-at-least-32-characters-long

# -----------------------------------------------------------------------------
# Google OAuth 2.0
# -----------------------------------------------------------------------------
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# -----------------------------------------------------------------------------
# Redis (Upstash recommended for serverless)
# -----------------------------------------------------------------------------
# Upstash: https://console.upstash.com
# Local: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
# Resend API key: https://resend.com/api-keys
# Leave empty to use console sink in development
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# From address for outgoing emails
EMAIL_FROM=SaathiCare <noreply@saathicare.com>

# -----------------------------------------------------------------------------
# SMS (Twilio) — Optional, leave empty to use console sink
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15551234567

# -----------------------------------------------------------------------------
# Web Push (VAPID)
# -----------------------------------------------------------------------------
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=Bxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Must be a mailto: URL or HTTPS URL
VAPID_SUBJECT=mailto:push@saathicare.com

# -----------------------------------------------------------------------------
# Frontend / CORS
# -----------------------------------------------------------------------------
# URL of the deployed frontend (no trailing slash)
CLIENT_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Frontend (Vite) Environment Variables
# These are prefixed VITE_ and exposed to the browser
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_APP_NAME=SaathiCare
VITE_VAPID_PUBLIC_KEY=Bxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# File Storage (optional — Cloudinary / S3 for medical documents)
# -----------------------------------------------------------------------------
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
